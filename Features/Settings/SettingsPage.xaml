<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Converto.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#151233">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,32" Spacing="16">
            <Label Text="SETTINGS"
                   Style="{StaticResource SectionEyebrowLabelStyle}" />

            <Label Text="Manage app preferences"
                   Style="{StaticResource PageTitleLabelStyle}" />

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="General"
                           Style="{StaticResource SectionTitleLabelStyle}" />

                    <Label Text="Settings will be expanded after the core conversion flow is working."
                           Style="{StaticResource BodyLabelStyle}" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>