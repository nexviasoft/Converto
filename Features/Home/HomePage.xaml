<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Converto.Features.Home.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#151233">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,32" Spacing="16">

            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <VerticalStackLayout Spacing="4">
                    <Label Text="CONVERTO"
                           Style="{StaticResource SectionEyebrowLabelStyle}" />

                    <Label Text="Free file conversion with a cleaner mobile workflow"
                           Style="{StaticResource PageTitleLabelStyle}" />
                </VerticalStackLayout>

                <Frame WidthRequest="48"
                       HeightRequest="48"
                       CornerRadius="24"
                       Padding="0"
                       BackgroundColor="#1AFFFFFF"
                       BorderColor="#1AFFFFFF"
                       HasShadow="False">
                    <Label Text="C"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="22" />
                </Frame>
            </Grid>

            <Label Text="Convert video, audio, image, and document files with a UI aligned to the Converto web experience."
                   Style="{StaticResource BodyLabelStyle}" />

            <HorizontalStackLayout Spacing="12">
                <Button Text="Open converter"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Clicked="OnOpenVideoClicked" />

                <Button Text="See Pro"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Clicked="OnOpenProClicked" />
            </HorizontalStackLayout>

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Popular conversion paths"
                           Style="{StaticResource SectionEyebrowLabelStyle}" />

                    <Label Text="Start with the most common workflows"
                           Style="{StaticResource SectionTitleLabelStyle}" />

                    <Label Text="Use quick entry points for the conversions people perform most often in Converto."
                           Style="{StaticResource BodyLabelStyle}" />

                    <FlexLayout Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="Start"
                                AlignItems="Start">

                        <Button Text="MP4 to MP3"
                                Style="{StaticResource ChipButtonStyle}"
                                Margin="0,0,10,10"
                                Clicked="OnOpenVideoClicked" />

                        <Button Text="MP4 to WAV"
                                Style="{StaticResource ChipButtonStyle}"
                                Margin="0,0,10,10"
                                Clicked="OnOpenVideoClicked" />

                        <Button Text="WEBM to MP3"
                                Style="{StaticResource ChipButtonStyle}"
                                Margin="0,0,10,10"
                                Clicked="OnOpenVideoClicked" />

                        <Button Text="MOV to MP4"
                                Style="{StaticResource ChipButtonStyle}"
                                Margin="0,0,10,10"
                                Clicked="OnOpenVideoClicked" />
                    </FlexLayout>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Features"
                           Style="{StaticResource SectionEyebrowLabelStyle}" />

                    <Label Text="Built for simple everyday conversion"
                           Style="{StaticResource SectionTitleLabelStyle}" />

                    <Label Text="Clean UI, fast actions, direct output downloads, and room for backend-powered heavy conversions."
                           Style="{StaticResource BodyLabelStyle}" />

                    <VerticalStackLayout Spacing="12" Margin="0,8,0,0">
                        <Label Text="• Clean dark UI aligned with Converto web"
                               Style="{StaticResource BodyLabelStyle}" />
                        <Label Text="• Backend-ready conversion flow"
                               Style="{StaticResource BodyLabelStyle}" />
                        <Label Text="• Quick access to popular formats"
                               Style="{StaticResource BodyLabelStyle}" />
                        <Label Text="• Future-ready Pro experience"
                               Style="{StaticResource BodyLabelStyle}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="About Converto"
                           Style="{StaticResource SectionEyebrowLabelStyle}" />

                    <Label Text="Free online and app-based conversion tools"
                           Style="{StaticResource SectionTitleLabelStyle}" />

                    <Label Text="The goal is a focused conversion experience: choose a file or link, select the target format, convert, and download with as little friction as possible."
                           Style="{StaticResource BodyLabelStyle}" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>