<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="#151233" />
    </Style>

    <Style x:Key="PageTitleLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="SectionEyebrowLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="#73FFFFFF" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1.8" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="SectionTitleLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="BodyLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="#A6FFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="MutedLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="#73FFFFFF" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="Black" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#14FFFFFF" />
        <Setter Property="TextColor" Value="#CCFFFFFF" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderColor" Value="#1AFFFFFF" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <Style x:Key="ChipButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#14FFFFFF" />
        <Setter Property="TextColor" Value="#CCFFFFFF" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderColor" Value="#1AFFFFFF" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <Style x:Key="CardFrameStyle" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="#1AFFFFFF" />
        <Setter Property="BorderColor" Value="#1AFFFFFF" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
</ResourceDictionary>